{
  "name": "precision-slate-erp-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-dist-external-urls.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e:reservations": "playwright test --config=playwright.config.ts",
    "gen:api": "openapi-typescript api-contract/openapi.snapshot.yaml -o src/shared/api/generated/schema.d.ts",
    "capture:parity": "node scripts/capture-react-parity.mjs",
    "a11y": "node scripts/check-accessibility.mjs",
    "contract:check": "node scripts/check-api-contract.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "5.1.1",
    "@hookform/resolvers": "3.10.0",
    "@tanstack/react-query": "5.104.1",
    "core-js": "3.51.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "msw": "2.7.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.89.0",
    "react-router-dom": "7.18.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.17.0",
    "@playwright/test": "1.55.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.1.0",
    "jsdom": "25.0.1",
    "openapi-typescript": "7.6.1",
    "prettier": "3.4.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.55.0",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
